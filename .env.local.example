NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Rebill (app.rebill.co.za) — Settings → Developer → API Access
REBILL_API_KEY=
REBILL_API_BASE=https://api.rebill.co.za

# Supabase service_role key — Settings → API. Server-side ONLY.
# Bypasses all Row Level Security; used just for the admin user-management
# actions in src/app/admin/users/actions.ts. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Used in password-reset emails to build the return link.
NEXT_PUBLIC_SITE_URL=https://app.wmfixandfinish.co.za

# Brevo (brevo.com) — used to email reports to clients from
# support@wmfixandfinish.co.za. In Brevo: Settings → SMTP & API → API Keys to
# get this key, and Senders, Domains & Dedicated IPs → Senders to add and
# verify support@wmfixandfinish.co.za as a sender (and ideally the domain
# itself, for SPF/DKIM) before it can send FROM that address.
BREVO_API_KEY=
